# LiveKit Cloud project — get from https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# SIP outbound trunk ID — created via `lk sip outbound create` after Telnyx is configured
SIP_OUTBOUND_TRUNK_ID=

# Telnyx — from portal.telnyx.com (Voice Suite -> SIP Trunking)
TELNYX_PHONE_NUMBER=+1XXXXXXXXXX
TELNYX_SIP_ADDRESS=sip.telnyx.com
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=
TELNYX_CONNECTION_ID=

# Cal.com — API key from app.cal.com/settings/developer/api-keys
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# Claude — get from console.anthropic.com
ANTHROPIC_API_KEY=

# Deepgram (STT) — get from console.deepgram.com
DEEPGRAM_API_KEY=

# Cartesia (TTS) — get from play.cartesia.ai
CARTESIA_API_KEY=
