# LiveKit Cloud project — get from https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Phone number callers dial (purchased via LiveKit Cloud → Telephony → Phone numbers)
LIVEKIT_PHONE_NUMBER=+1XXXXXXXXXX

# Receptionist persona
BUSINESS_NAME=James Bradford Consulting
OWNER_NAME=James

# Cal.com — API key from app.cal.com/settings/developer/api-keys
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# Claude — get from console.anthropic.com
ANTHROPIC_API_KEY=

# Deepgram (STT) — get from console.deepgram.com
DEEPGRAM_API_KEY=

# Cartesia (TTS) — get from play.cartesia.ai
CARTESIA_API_KEY=
